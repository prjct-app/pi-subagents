{
  "name": "@prjct.app/pi-subagents",
  "version": "0.5.0",
  "description": "Delegate separable work to autonomous subagents that run beside a PI Agent session and report back with evidence.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "subagents",
    "multi-agent",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-subagents/main/docs/cover.png"
  },
  "scripts": {
    "build": "rm -rf build && mkdir -p build && npm pack --ignore-scripts --pack-destination build >/dev/null && tar -xzf build/*.tgz -C build --strip-components=1 && rm -f build/*.tgz",
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "test": "node --import ./tests/isolate.mjs --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts",
    "demo:tui": "node --import tsx scripts/tui-demo.ts",
    "preview:tui": "node --import tsx scripts/tui-demo.ts --snapshot",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "build:pi": "node scripts/build-pi.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-subagents.git"
  },
  "homepage": "https://github.com/prjct-app/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-subagents/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "factory/agents",
    "factory/skills/*/SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/cover.png"
  ],
  "piBuild": {
    "entries": [
      "index.ts",
      "src/child.ts"
    ],
    "copy": [
      "factory"
    ],
    "external": [
      "@prjct.app/pi-secrets/privacy"
    ]
  },
  "dependencies": {
    "@prjct.app/pi-secrets": "^0.2.1",
    "@prjct.app/pi-tui-kit": "^0.3.4"
  }
}
